<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>STTS Daily Inspection – Excel Export + Auto-Save Draft</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #e9f0ee;
            font-family: 'Inter', system-ui, 'Segoe UI', Roboto, sans-serif;
            padding: 24px 16px;
        }

        .form-container {
            max-width: 1000px;
            margin: 0 auto;
            background: white;
            border-radius: 32px;
            box-shadow: 0 20px 35px rgba(0, 0, 0, 0.08);
            overflow: hidden;
        }

        .doc-header {
            background: #004d40;
            padding: 22px 28px;
            color: white;
        }

        .doc-header h1 {
            font-size: 1.8rem;
            font-weight: 600;
            letter-spacing: -0.3px;
        }

        .doc-header .sub {
            font-size: 0.85rem;
            opacity: 0.85;
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            margin-top: 6px;
        }

        .meta-bar {
            background: #f9fcfb;
            padding: 16px 28px;
            display: flex;
            flex-wrap: wrap;
            gap: 28px;
            border-bottom: 1px solid #d4e2de;
            align-items: center;
        }

        .meta-item {
            display: flex;
            align-items: baseline;
            gap: 12px;
            flex-wrap: wrap;
        }

        .meta-item label {
            font-weight: 700;
            color: #00695c;
            font-size: 0.85rem;
        }

        .required-star {
            color: #c62828;
            font-weight: bold;
            margin-left: 2px;
        }

        input, select, textarea {
            padding: 8px 16px;
            border-radius: 40px;
            border: 1px solid #cbdcd6;
            background: white;
            font-family: 'Courier New', 'Fira Code', monospace;
            font-weight: 500;
            font-size: 0.85rem;
        }

        /* Uppercase styling for text inputs/areas but placeholder remains normal case visually */
        input.caps, textarea.caps {
            text-transform: uppercase;
        }
        
        /* Placeholder styling - grey color and italic for better visibility */
        input::placeholder, textarea::placeholder {
            color: #9e9e9e;
            font-style: italic;
            text-transform: none;
            opacity: 0.8;
            font-weight: 400;
        }

        textarea {
            border-radius: 20px;
            font-family: monospace;
        }

        .section {
            margin-top: 2px;
        }

        .section-title {
            background: #e0f2f1;
            padding: 12px 28px;
            font-weight: 800;
            font-size: 1.1rem;
            color: #004d40;
            border-left: 6px solid #00897b;
            margin-top: 8px;
        }

        .field-row {
            padding: 12px 28px;
            border-bottom: 1px solid #edf3f0;
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
        }

        .field-row .label {
            font-weight: 700;
            font-size: 0.85rem;
            color: #1a3e36;
            min-width: 240px;
            width: 35%;
        }

        .field-row .input-area {
            flex: 1;
            min-width: 180px;
        }

        select, input, textarea {
            width: 100%;
            background: #fff;
        }

        .inline-cluster {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            align-items: center;
        }

        .inline-cluster select, .inline-cluster input {
            width: auto;
            min-width: 80px;
        }

        .cctv-group {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            background: #fafefc;
            padding: 8px 0;
        }

        .cctv-unit {
            background: #f4f9f7;
            padding: 6px 12px;
            border-radius: 48px;
            display: inline-flex;
            gap: 12px;
            align-items: center;
        }

        .action-buttons {
            display: flex;
            gap: 16px;
            margin: 24px 28px 20px 28px;
            flex-wrap: wrap;
        }

        .btn-primary {
            flex: 1;
            padding: 14px;
            font-weight: bold;
            font-size: 1rem;
            border-radius: 60px;
            cursor: pointer;
            transition: 0.2s;
            border: none;
            text-align: center;
            background: #00695c;
            color: white;
        }

        .btn-primary:hover {
            background: #00897b;
        }

        .legend {
            background: #fff7e5;
            padding: 12px 28px;
            font-size: 0.7rem;
            color: #a86407;
            border-top: 1px solid #ffe0b5;
        }

        .auto-save-badge {
            background: #e8f5e9;
            border-radius: 40px;
            padding: 6px 14px;
            font-size: 0.75rem;
            font-weight: 600;
            color: #2e7d32;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-left: auto;
        }

        @media (max-width: 700px) {
            .field-row {
                flex-direction: column;
                align-items: flex-start;
            }
            .field-row .label {
                width: 100%;
            }
            .action-buttons {
                flex-direction: column;
            }
        }

        .validation-error {
            border: 2px solid #c62828 !important;
            background-color: #ffebee !important;
        }
        
        /* Ensure selects don't get weird styling */
        select option {
            text-transform: uppercase;
        }
    </style>
</head>
<body>
<div class="form-container">
    <div class="doc-header">
        <h1>STTS DAILY INSPECTION FORM</h1>
        <div class="sub"><span>CONTRACT EP/SP/76/14 | DOIF-STTS-002-V2</span><span>SHA TIN TRANSFER STATION</span></div>
    </div>

    <div class="meta-bar">
