<!-- SheetJS (XLSX) library for native Excel export -->
<script src="https://cdn.sheetjs.com/xlsx-0.20.2/package/dist/xlsx.full.min.js"></script>
<script>
    // enforce uppercase on all text inputs / textareas (but placeholder remains as defined)
    const allCapsFields = document.querySelectorAll('.caps');
    function enforceUppercase(e) {
        // Only convert actual user input, not placeholder
        if (e.target.value && e.target.value !== e.target.placeholder) {
            e.target.value = e.target.value.toUpperCase();
        }
    }
    allCapsFields.forEach(field => {
        field.addEventListener('input', enforceUppercase);
        // Ensure initial values are uppercase if they have content
        if (field.value && field.value !== field.placeholder) {
            field.value = field.value.toUpperCase();
        }
    });
    
    // ----- 1. AUTO-SAVE DRAFT (localStorage) for all form fields + meta
    const STORAGE_KEY = 'STTS_inspection_draft';
    const form = document.getElementById('inspectionForm');
    const inspectDateInput = document.getElementById('inspectDate');
    const shiftSelect = document.getElementById('shiftSelect');
    const weatherSel = document.getElementById('weatherSel');
    const checkedByInput = document.querySelector('input[name="checked_by"]');
    
    // Helper: collect all current data (including meta)
    function collectFullDraft() {
        const formData = new FormData(form);
        const draft = {
            meta: {
                inspection_date: inspectDateInput.value,
                shift_time: shiftSelect.value,
                weather: weatherSel.value
            },
            fields: {}
        };
        for (let [key, value] of formData.entries()) {
            draft.fields[key] = value;
        }
        return draft;
    }
    
    // Restore draft from localStorage
    function restoreDraft() {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (!saved) return false;
        try {
            const draft = JSON.parse(saved);
            if (draft.meta) {
                if (draft.meta.inspection_date) inspectDateInput.value = draft.meta.inspection_date;
                if (draft.meta.shift_time) shiftSelect.value = draft.meta.shift_time;
                if (draft.meta.weather) weatherSel.value = draft.meta.weather;
            }
            if (draft.fields) {
                for (const [fieldName, fieldValue] of Object.entries(draft.fields)) {
                    const inputEl = document.querySelector(`[name="${fieldName}"]`);
                    if (inputEl) {
                        if (inputEl.tagName === 'TEXTAREA' || inputEl.tagName === 'INPUT' || inputEl.tagName === 'SELECT') {
                            inputEl.value = fieldValue;
                        }
                    }
                }
            }
            showBadgeMessage('Draft restored', '#4caf50');
            return true;
        } catch(e) { console.warn(e); return false; }
    }
    
    // Save current state to localStorage
    function persistDraft() {
        const draft = collectFullDraft();
        localStorage.setItem(STORAGE_KEY, JSON.stringify(draft));
        showBadgeMessage('Draft saved', '#2e7d32');
    }
    
    let badgeTimeout;
    function showBadgeMessage(msg, color) {
        const badge = document.getElementById('autoSaveBadge');
        const originalHtml = badge.innerHTML;
        badge.style.background = color;
        badge.innerHTML = `💾 ${msg}`;
        if (badgeTimeout) clearTimeout(badgeTimeout);
        badgeTimeout = setTimeout(() => {
            badge.style.background = '#e8f5e9';
            badge.innerHTML = originalHtml;
        }, 1800);
    }
    
    // Attach input listeners to all form fields for auto-save (debounced)
    let saveTimer;
    function autoSaveHandler() {
        clearTimeout(saveTimer);
        saveTimer = setTimeout(() => {
            persistDraft();
        }, 400);
    }
    
    function attachAutoSave() {
        const allFormControls = form.querySelectorAll('input, select, textarea');
        allFormControls.forEach(ctrl => {
            ctrl.addEventListener('input', autoSaveHandler);
            ctrl.addEventListener('change', autoSaveHandler);
        });
        inspectDateInput.addEventListener('change', autoSaveHandler);
        shiftSelect.addEventListener('change', autoSaveHandler);
        weatherSel.addEventListener('change', autoSaveHandler);
    }
    
    // Validate mandatory fields: inspection date, shift, checked_by
    function validateMandatoryFields() {
        let valid = true;
        const shiftOk = shiftSelect.value.trim() !== '';
        const dateOk = inspectDateInput.value.trim() !== '';
        const officerOk = checkedByInput.value.trim() !== '';
        
        if (!dateOk) {
            inspectDateInput.classList.add('validation-error');
            valid = false;
        } else inspectDateInput.classList.remove('validation-error');
        
        if (!shiftOk) shiftSelect.classList.add('validation-error');
        else shiftSelect.classList.remove('validation-error');
        
        if (!officerOk) {
            checkedByInput.classList.add('validation-error');
            valid = false;
        } else checkedByInput.classList.remove('validation-error');
        
        if (!valid) {
            alert('❌ MANDATORY FIELDS MISSING:\n- Inspection Date\n- Shift/Time\n- Officer ID (Checked By)\nPlease complete them before exporting.');
        }
        return valid;
    }
    
    // Build flat data object for Excel (horizontal headers)
    function getFlatDataForExport() {
        const flat = {};
        flat['inspection_date'] = inspectDateInput.value;
        flat['shift_time'] = shiftSelect.value;
        flat['weather'] = weatherSel.value;
        
        const formElements = form.elements;
        for (let i = 0; i < formElements.length; i++) {
            const el = formElements[i];
            if (el.name) {
                let val = el.value;
                if (typeof val === 'string') val = val.replace(/\r?\n|\r/g, ' ').replace(/\s+/g, ' ').trim();
                flat[el.name] = val;
            }
        }
        return flat;
    }
    
    // Export to native XLSX (Excel) with headers in first row and data in second row
    function exportToExcel() {
        if (!validateMandatoryFields()) return;
        
        const flatData = getFlatDataForExport();
        
        // Define column order (logical sequence matching form)
        const orderedKeys = [
            'inspection_date', 'shift_time', 'weather',
            'ind_water', 'ww_flow', 'wb_cpu', 'wb1', 'wb2', 'wb3', 'bar1', 'bar2', 'bar3',
            'cctv1_in', 'cctv1_out', 'cctv2_in', 'cctv2_out', 'cctv3_in', 'cctv3_out',
            'wb_op', 'void_tkt', 'water_spray', 'traffic_vwp', 'rec_water',
            'live1', 'live2', 'live3', 'fan1', 'fan2', 'ctrl_op', 'tipper_asst', 'th_light',
            'comp1', 'comp2', 'comp3',
            'oep1', 'oep2', 'oep3', 'oep4', 'oep5', 'oep6', 'oep7', 'oep8',
            'oep9', 'oep10', 'oep11', 'oep12', 'oep13', 'oep14', 'oep15', 'oep16',
            'oep17', 'oep18', 'oep19', 'oep20', 'oep21', 'oep22', 'oep23', 'oep24',
            'oep25', 'oep26', 'oep27', 'oep28', 'oep29',
            'rcv_vehicle', 'rcv_type', 'rcv_waste_type', 'rcv_ticket', 'rcv_container_clean', 'rcv_remarks',
            'general_remarks', 'checked_by'
        ];
        
        const finalHeaders = [];
        const finalRow = [];
        for (let key of orderedKeys) {
            if (flatData.hasOwnProperty(key)) {
                finalHeaders.push(key);
                finalRow.push(flatData[key] !== undefined ? flatData[key] : '');
            }
        }
        // Append any extra keys not in ordered (just safety)
        for (let key of Object.keys(flatData)) {
            if (!finalHeaders.includes(key)) {
                finalHeaders.push(key);
                finalRow.push(flatData[key]);
            }
        }
        
        const worksheetData = [finalHeaders, finalRow];
        const ws = XLSX.utils.aoa_to_sheet(worksheetData);
        const wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, 'STTS_Daily_Inspection');
        
        const timestamp = new Date().toISOString().slice(0,19).replace(/:/g, '-');
        XLSX.writeFile(wb, `STTS_Inspection_${timestamp}.xlsx`);
        
        alert('✅ Excel file (.xlsx) exported successfully!\nHeaders are in first row, inspection data in second row.');
    }
    
    // Initialize: restore draft and attach auto-save (no clear button)
    restoreDraft();
    attachAutoSave();
    // initial persist to ensure draft exists
    setTimeout(() => persistDraft(), 500);
    
    document.getElementById('exportExcelBtn').addEventListener('click', exportToExcel);
</script>
</body>
</html>
